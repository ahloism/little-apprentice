{
  "dialogues_id": "asui_dialogues",
  "dialogues": [
    {
      "trigger": "onboarding_1",
      "type": "fixed",
      "condition": "first_map_entry",
      "text": "大梁城好大，我怕你迷路——我們一起把走過的地方畫下來吧！"
    },
    {
      "trigger": "onboarding_2",
      "type": "fixed",
      "condition": "first_location_appear",
      "text": "你去過的地方會被畫出來，沒去過的還是空白。去的地方越多，地圖就越完整！"
    },
    {
      "trigger": "onboarding_3",
      "type": "fixed",
      "condition": "first_coins_earned",
      "text": "每走過一個地方都會得到銅錢，問題答得越好，銅錢就會越多！"
    },
    {
      "trigger": "onboarding_4",
      "type": "fixed",
      "condition": "first_unlock_available",
      "text": "攢夠了一定數量的銅錢，就可以在你去過的地方解鎖小任務！"
    },
    {
      "trigger": "onboarding_5",
      "type": "fixed",
      "condition": "first_game_complete",
      "text": "成功完成了小任務，地圖會變彩色，一起來把地圖填滿色彩吧？"
    },
    {
      "trigger": "first_unlock_prompt",
      "type": "fixed",
      "condition": "first_tap_unlockable_location",
      "text": "這個地方可以解鎖小任務了！點一點，看看要花多少銅錢。"
    },
    {
      "trigger": "after_event",
      "event_id": "story_1_1",
      "type": "fixed",
      "text": "第一天就去商行取貨，還認識了錢伯！對了，糖葫蘆是串在竹簽上的，記住了嗎？下一站是市集，跟緊我！"
    },
    {
      "trigger": "after_event",
      "event_id": "story_1_2",
      "type": "fixed",
      "text": "石頭那個人……一動不動盯著我們，我當時真的不知道他想做什麼。下一站是橋邊，走！"
    },
    {
      "trigger": "after_event",
      "event_id": "story_1_3",
      "type": "fixed",
      "text": "橋邊那三個人，梅姐、阿乖、王三——說的話完全不一樣。你覺得誰說的是真的？下一關要好好想清楚！"
    },
    {
      "trigger": "after_event",
      "event_id": "story_1_5",
      "type": "fixed",
      "text": "杜先生那兩個謎語，頭加馬等於碼頭——說起來簡單，當時可不容易！老梁原來一直在碼頭等我們。走，去碼頭！"
    },
    {
      "trigger": "after_event",
      "event_id": "story_1_6",
      "type": "fixed",
      "text": "在碼頭，你面對了花生那件事。說實話不容易，但做到了就是做到了。石頭那個人……我覺得他還不錯。"
    },
    {
      "trigger": "after_event",
      "event_id": "story_1_7",
      "type": "fixed",
      "text": "帳房那一關，真的不容易。錢伯說的那句話——不識字路難行，不誠信路也難行——我記住了。你呢？"
    },
    {
      "trigger": "coins_insufficient",
      "type": "fixed",
      "text": "銅錢還不夠！繼續去走走，答得好一點，銅錢會越來越多的！"
    },
    {
      "trigger": "map_almost_complete",
      "type": "fixed",
      "condition": "map_colored >= 4",
      "text": "地圖快畫完了！還差一個地方，加油！"
    },
    {
      "trigger": "map_complete",
      "type": "fixed",
      "text": "地圖畫完了！大梁城，我們走遍了每一個角落！……等等，好像還有一個秘密沒發現？繼續冒險，看看前面有什麼！"
    },
    {
      "trigger": "after_assessment",
      "type": "personalized",
      "event_id": "story_1_4",
      "scene_id": "1_4_2",
      "label": "A",
      "text": "信梅姐是對的！她就在攤檔旁邊，老梁不在她第一個知道。下次記住——最近的人，往往最清楚。"
    },
    {
      "trigger": "after_assessment",
      "type": "personalized",
      "event_id": "story_1_4",
      "scene_id": "1_4_2",
      "label": "B",
      "text": "阿乖那個人，說話油滑，地圖也是假的——去到化糞池才發現，真的很臭！下次看人要看眼神，不是看他說得多詳細。"
    },
    {
      "trigger": "after_assessment",
      "type": "personalized",
      "event_id": "story_1_4",
      "scene_id": "1_4_2",
      "label": "C",
      "text": "王三說得很詳細，但詳細不等於真實——說得越多，有時候反而要越小心。這次記住了嗎？"
    }
  ]
}

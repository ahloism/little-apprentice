    {
      "applies_to": [
        "R1",
        "R2",
        "R3",
        "R4",
        "R5"
      ],
      "confirm_buttons": {
        "confirm": "去！",
        "cancel": "算了"
      }
    },
    {
      "applies_to": [
        "M1"
      ],
      "display_mode": "sequential_lines",
      "dismiss": "tap_per_line"
    },
